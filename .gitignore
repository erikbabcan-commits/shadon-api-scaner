# ==============================================================================
# STRÁŽ — Git Ignore Policy
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
# Only sanitized templates are versioned; the secret gate rejects forced credentials.
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# Local databases & persistent storage
*.db
*.sqlite
*.sqlite3
straz.db
apps/api/straz.db
/backups/
*.sql.gz
*.dump
*.backup

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Python Testing, Linting & Coverage
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node.js & Frontend builds
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
apps/web/dist/
apps/web/dev-dist/
dist/
out/
.vite/

# Vercel & Deployment tools
.vercel/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# macOS & OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary files
*.log
*.tmp
*.bak
*.orig
