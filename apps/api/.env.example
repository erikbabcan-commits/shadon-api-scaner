# STRÁŽ — local API template. Fill PRIVATE values before starting.
# Redis and PostgreSQL must be started separately; migrate PostgreSQL before API/worker.
# See ../../docs/ENVIRONMENT.md. SQLite is for isolated tests, not production evidence.
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

STRAZ_ADMIN_EMAIL=admin@example.invalid
STRAZ_ADMIN_PASSWORD=
STRAZ_SESSION_SECRET=
STRAZ_COOKIE_SECURE=false
STRAZ_COOKIE_SAMESITE=lax
STRAZ_ENV=development
APP_FRONTEND_URL=http://localhost:5173
STRAZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Step 2 only: leave blank until billing is configured and verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
