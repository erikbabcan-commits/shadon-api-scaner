# Public build configuration only. Never add backend secrets with a VITE_ prefix.
# Origin without /api. Empty uses same-origin /api and requires an actual proxy.
# On *.vercel.app the client always uses same-origin, regardless of VITE_API_URL.
# Lovable/custom hosts need a configured API origin or a verified same-origin proxy.
VITE_API_URL=

# Local Vite /api proxy. Does not configure production ingress.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
